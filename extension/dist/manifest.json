{
    "manifest_version": 3,
    "name": "Reel Offline Downloader",
    "version": "1.0",
    "description": "Downloads reels automatically as you scroll",
    "permissions": ["activeTab", "tabs", "webNavigation"],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}